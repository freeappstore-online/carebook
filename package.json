{
  "name": "carebook",
  "description": "Coming soon — a private medication and blood-pressure diary: log doses and vitals, see trends, and share a PDF with your clinician. Everything stays on your device.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/carebook.git"
  },
  "scripts": {
    "dev": "pnpm --filter @carebook/web dev",
    "build": "pnpm --filter @carebook/web build",
    "preview": "pnpm --filter @carebook/web preview",
    "typecheck": "pnpm --filter @carebook/web exec tsc -b",
    "test": "pnpm --filter @carebook/web exec tsc -b"
  }
}
